-- 翻译文本函数
-- ========================================

local function translateText(text)

    if not text or type(text) ~= "string" then
        return text
    end


    -- 完全匹配

    if Translations[text] then

        return Translations[text]

    end



    -- 部分匹配

    for en,cn in pairs(Translations) do

        if string.find(text,en,1,true) then

            text = string.gsub(
                text,
                en,
                cn
            )

        end

    end


    return text

end





-- ========================================
-- 单个GUI翻译
-- ========================================

local function translateGui(gui)

    if not gui then
        return
    end



    if gui:IsA("TextLabel")
    or gui:IsA("TextButton")
    or gui:IsA("TextBox") then


        pcall(function()


            local oldText = gui.Text


            if oldText and oldText ~= "" then


                local newText =
                    translateText(oldText)



                if newText ~= oldText then


                    gui.Text = newText


                end


            end


        end)


    end


end





-- ========================================
-- 扫描GUI
-- ========================================

local function scanGui(parent)


    if not parent then
        return
    end



    pcall(function()


        for _,gui in ipairs(
            parent:GetDescendants()
        ) do


            translateGui(gui)


        end


    end)


end





-- ========================================
-- 汉化监听引擎
-- ========================================

local function setupTranslationEngine()



    local Players =
        game:GetService("Players")



    local CoreGui =
        game:GetService("CoreGui")



    local LocalPlayer =
        Players.LocalPlayer




    -- 初次扫描

    scanGui(CoreGui)



    if LocalPlayer
    and LocalPlayer:FindFirstChild("PlayerGui") then


        scanGui(
            LocalPlayer.PlayerGui
        )


    end





    -- 监听CoreGui新增UI

    pcall(function()


        CoreGui.DescendantAdded:Connect(
            function(gui)


                task.wait(0.1)


                translateGui(gui)


            end
        )


    end)





    -- 监听PlayerGui新增UI

    if LocalPlayer then


        pcall(function()


            LocalPlayer.PlayerGui.DescendantAdded:Connect(
                function(gui)


                    task.wait(0.1)


                    translateGui(gui)


                end
            )


        end)


    end





    -- 循环扫描防止漏翻

    task.spawn(function()


        while true do


            scanGui(CoreGui)



            if LocalPlayer
            and LocalPlayer:FindFirstChild("PlayerGui") then


                scanGui(
                    LocalPlayer.PlayerGui
                )


            end



            task.wait(3)


        end


    end)



end
